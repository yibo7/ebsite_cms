  "about_company_intro": "<strong><span style=\"color:#1b4d3d;\">Green Rich\uff08\u91d1\u745e\u6cbb\uff09</span></strong>\u662f\u4e00\u5bb6\u6210\u7acb\u4e8e 1997 \u5e74\u7684\u8017\u6750\u54c1\u724c\u516c\u53f8\uff0c\u4e13\u6ce8\u4e8e\u590d\u5370\u673a\u611f\u5149\u9f13\u82af\u7684\u7814\u53d1\u3001\u5236\u9020\u548c\u9500\u552e\u3002\u516c\u53f8\u65d7\u4e0b\u62e5\u6709 <strong><span style=\"color:#1b4d3d;\">Green Rich\uff08\u91d1\u745e\u6cbb\uff09</span></strong> \u4e0e <strong><span style=\"color:#b23e2d;\">\u7ea2\u7c73</span></strong> \u4e24\u4e2a\u77e5\u540d\u54c1\u724c\uff0c\u5728\u884c\u4e1a\u5185\u4ee5<strong><span style=\"color:#16634f;\">\u9ad8\u54c1\u8d28\u3001\u9ad8\u6027\u4ef7\u6bd4</span></strong>\u7684\u9f13\u82af\u4ea7\u54c1\u8457\u79f0\u3002Green Rich \u81f4\u529b\u4e8e\u4e3a\u7528\u6237\u63d0\u4f9b\u5353\u8d8a\u7684\u6253\u5370\u4f53\u9a8c\uff0c\u901a\u8fc7\u7cbe\u5bc6\u7684\u5de5\u827a\u548c\u4f18\u8d28\u7684\u6750\u6599\uff0c\u786e\u4fdd\u6253\u5370\u7ed3\u679c\u7684<strong><span style=\"color:#16634f;\">\u6e05\u6670\u5ea6\u548c\u6301\u4e45\u6027</span></strong>\u3002\u65e0\u8bba\u662f\u5bb6\u5ead\u7528\u6237\u8fd8\u662f\u4f01\u4e1a\u5ba2\u6237\uff0cGreen Rich \u90fd\u63d0\u4f9b\u5e7f\u6cdb\u7684\u4ea7\u54c1\u7cfb\u5217\uff0c\u6db5\u76d6\u5404\u79cd\u578b\u53f7\u548c\u89c4\u683c\u7684\u590d\u5370\u673a\u9f13\u82af\uff0c\u4ee5\u6ee1\u8db3\u4e0d\u540c\u9700\u6c42\u3002\u7ea2\u7c73\u54c1\u724c\u4e13\u6ce8\u4e8e\u590d\u5370\u673a\u9f13\u82af\u9886\u57df\uff0c\u4e3a\u7528\u6237\u63d0\u4f9b\u9ad8\u6027\u80fd\u7684\u590d\u5370\u673a\u9f13\u82af\u89e3\u51b3\u65b9\u6848\u3002\u7ea2\u7c73\u9f13\u82af\u4ee5\u5176\u5353\u8d8a\u7684\u6027\u80fd\u548c\u53ef\u9760\u6027\u800c\u5907\u53d7\u8d5e\u8a89\uff0c\u4fdd\u8bc1\u4e86\u9ad8\u8d28\u91cf\u7684\u590d\u5370\u8f93\u51fa\u6548\u679c\u3002\u4e0d\u8bba\u662f\u5728\u529e\u516c\u5ba4\u8fd8\u662f\u5b66\u6821\u7b49\u73af\u5883\u4e2d\uff0c\u7ea2\u7c73\u4e3a\u7528\u6237\u63d0\u4f9b\u4e86\u7a33\u5b9a\u3001\u9ad8\u6548\u7684\u590d\u5370\u4f53\u9a8c\uff0c\u6ee1\u8db3\u4e86\u5927\u91cf\u6587\u4ef6\u590d\u5236\u548c\u6253\u5370\u7684\u9700\u6c42\u3002Green Rich\uff08\u91d1\u745e\u6cbb\uff09\u51ed\u501f\u591a\u5e74\u6765\u5728\u590d\u5370\u673a\u9f13\u82af\u9886\u57df\u7684<strong><span style=\"color:#1b4d3d;\">\u4e13\u4e1a\u7ecf\u9a8c\u548c\u6280\u672f\u5b9e\u529b</span></strong>\uff0c\u4e0d\u65ad\u63a8\u52a8\u884c\u4e1a\u7684\u53d1\u5c55\u548c\u521b\u65b0\u3002",

